/* =====================================================
   AFFICHER LES ANIMAUX
===================================================== */

const grille = document.getElementById("grilleAnimaux");
const recherche = document.getElementById("rechercheAnimal");
const zoneFiche = document.getElementById("ficheAnimal");

let categorieActuelle = "Tous";


function afficherAnimaux(){

  const texte = recherche.value
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g,"");

  const resultat = animaux.filter(animal => {

    const nom = animal.nom
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g,"");

    const categorieOK =
      categorieActuelle === "Tous" ||
      animal.categorie === categorieActuelle;

    const rechercheOK =
      nom.includes(texte);

    return categorieOK && rechercheOK;
  });


  if(resultat.length === 0){

    grille.innerHTML = `
      <div class="message">
        ❌ Aucun animal trouvé.
      </div>
    `;

    return;
  }


  grille.innerHTML = resultat.map(animal => `

    <div class="animal"
         onclick="afficherFiche('${animal.key}')">

      <div class="animal-icon">
        ${animal.emoji}
      </div>

      <h3>${animal.nom}</h3>

      <p>${animal.classe}</p>

    </div>

  `).join("");
}


/* =====================================================
   OUVRIR UNE FICHE
===================================================== */

function afficherFiche(key){

  const animal = animaux.find(a => a.key === key);

  if(!animal){
    zoneFiche.innerHTML = `
      <div class="fiche">
        <h2>❌ Fiche introuvable</h2>
      </div>
    `;
    return;
  }


  zoneFiche.innerHTML = `

    <div class="fiche">

      <button class="fermer"
              onclick="fermerFiche()">
        ✕
      </button>

      <div class="grandEmoji">
        ${animal.emoji}
      </div>

      <h2>${animal.nom}</h2>

      <p>
        <strong>🧬 Classe :</strong>
        ${animal.classe}
      </p>

      <p>
        <strong>🍽️ Alimentation :</strong><br>
        ${animal.alimentation}
      </p>

      <p>
        <strong>🏠 Habitat :</strong><br>
        ${animal.habitat}
      </p>

      <p>
        <strong>📖 Description :</strong><br>
        ${animal.description}
      </p>

      <p>
        <strong>⭐ Importance :</strong><br>
        ${animal.importance}
      </p>

    </div>

  `;


  zoneFiche.scrollIntoView({
    behavior:"smooth",
    block:"start"
  });
}


/* =====================================================
   FERMER LA FICHE
===================================================== */

function fermerFiche(){

  zoneFiche.innerHTML = "";

}


/* =====================================================
   FILTRE
===================================================== */

function filtrer(categorie){

  categorieActuelle = categorie;

  afficherAnimaux();

  zoneFiche.innerHTML = "";

}


/* =====================================================
   RECHERCHE
===================================================== */

recherche.addEventListener("input", function(){

  afficherAnimaux();

});


/* =====================================================
   DÉMARRAGE
===================================================== */

afficherAnimaux();

</script>

